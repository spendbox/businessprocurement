# ---------- Resend (required for emails) ----------
# Create a key at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# The "from" address. The domain must be verified in Resend.
# e.g. "Spendbox <requests@spendbox.site>"
EMAIL_FROM="Spendbox <requests@spendbox.site>"

# Where YOUR team receives new requests. Comma-separate for several people.
EMAIL_TO_INTERNAL=you@spendbox.site

# Optional: replies from customers go here instead of EMAIL_FROM
EMAIL_REPLY_TO=hello@spendbox.site

# ---------- Supabase (optional — the site works without it) ----------
# If these are set, every request is also saved to your database.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxx

# ---------- Site ----------
NEXT_PUBLIC_SITE_URL=https://spendbox.site

# ---------- Admin dashboard (/admin) ----------
# Who can sign in. Change these here and redeploy to change the login.
ADMIN_EMAIL=you@spendbox.site
ADMIN_PASSWORD=pick-something-long-and-random

# Signs the login cookie. Any random string of 32+ characters.
# Generate one with:  openssl rand -base64 32
ADMIN_SESSION_SECRET=replace-me-with-32-or-more-random-characters

# ---------- Category auto-tagging (optional) ----------
# Without a key, categories are worked out by a built-in keyword matcher.
# Setting a key adds a language-model pass on top of it.
# Works with any OpenAI-compatible endpoint.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
